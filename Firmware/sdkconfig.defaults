CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# HID gamepad on the internal USB OTG PHY (GPIO19/20 on ESP32-S3)
# VID/PID and descriptors live in main/switch_hid.c
CONFIG_TINYUSB_HID_COUNT=1

# The OTG PHY belongs to TinyUSB — logs go out over UART0 only
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 1ms ticks so the control task can time taps properly
CONFIG_FREERTOS_HZ=1000

# Log suspend/resume from the host
CONFIG_TINYUSB_SUSPEND_CALLBACK=y
CONFIG_TINYUSB_RESUME_CALLBACK=y
